# ─── Meta Model API (Muse Spark + Muse Voice Transcribe) ─────────────────────
# Get a key: https://dev.meta.ai → log in → "API keys" tab → Create API key (shown only once)
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# ─── Discord ────────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → your app
DISCORD_TOKEN=                 # Bot tab → Reset Token
DISCORD_CLIENT_ID=             # General Information → Application ID
DISCORD_GUILD_ID=              # right-click your server → Copy Server ID (needs Developer Mode)
DISCORD_RECAP_CHANNEL_ID=      # right-click the text channel for recaps → Copy Channel ID
# Crew members register themselves in Discord (/orbit-setup button or /link-email). No IDs needed here.

# ─── Google Calendar (organizer account) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
# Leave blank: `npm run google:auth` saves the sign-in to data/google-token.json.
# (Setting a refresh token here overrides that file.)
GOOGLE_REFRESH_TOKEN=

# ─── App settings ───────────────────────────────────────────────────────────
TIMEZONE=America/New_York      # IANA name, used to resolve "tomorrow at 7"
DEFAULT_AREA=Downtown          # appended to a place when no specific location was said
DM_EVERYONE=true               # DM call participants for private constraints too, not just absent members
DASHBOARD_PORT=3000            # live "Orbit is thinking" screen at http://localhost:3000
